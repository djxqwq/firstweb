# 复制为 backend/.env 并填入真实值

# JWT 密钥（生成方式: python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=change-me-to-a-long-random-string

# 管理员账号
ADMIN_USER=1075751918
ADMIN_PASSWORD=change-me-to-strong-password
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库：
# 本地 SQLite（开发用）
DATABASE_URL=sqlite:///./backend/data.db
#
# TiDB Cloud / MySQL（生产用，需要 SSL）
# 1. 先在 TiDB Cloud 控制台创建名为 blog 的数据库
# 2. 填写连接串：
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:4000/blog?charset=utf8mb4

# CORS 白名单（生产环境填域名，逗号分隔；留空则允许全部）
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
