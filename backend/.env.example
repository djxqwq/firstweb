# 复制为项目根目录 .env 或 backend/.env
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=changeme123

# 本地默认 SQLite；服务器改成 TiDB（MySQL 协议）:
# DATABASE_URL=mysql+pymysql://user:password@tidb-host:4000/blog?charset=utf8mb4
DATABASE_URL=sqlite:///./backend/data.db

ACCESS_TOKEN_EXPIRE_MINUTES=720
